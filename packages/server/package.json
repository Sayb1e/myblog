{
  "name": "@myblog/server",
  "version": "1.3.1",
  "description": "Workspace API handlers for MyBlog (transport-agnostic, no network).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@myblog/agent": "*",
    "@myblog/core": "*"
  }
}
