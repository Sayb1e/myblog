{
  "name": "@myblog/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Desktop shell for MyBlog (Electron).",
  "type": "module",
  "main": "dist/main.js",
  "author": "MyBlog contributors",
  "scripts": {
    "build": "tsup",
    "fix:native": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty",
    "start": "npm run build && electron .",
    "dist": "node scripts/patch-node-pty.mjs && npm run build && electron-builder && node scripts/copy-changelog.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@myblog/core": "*",
    "@myblog/server": "*",
    "@types/node": "^22.10.0",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "dev.myblog.desktop",
    "productName": "MyBlog",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "portable": {
      "artifactName": "${productName}_v${version}_portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}_v${version}_setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "MyBlog",
      "runAfterFinish": true,
      "language": "2052",
      "license": "../../LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
